# Shared quota for the two 32 MiB images.  With 160 MiB both disks fit at
# their initial size with 96 MiB to spare, which is exactly enough for the
# "two disks fight for the quota" demo in docs/DEMO.md.
DISK_QUOTA_MIB: "160"
# Initial size of the seeded images (only used on the first start).
DISK_IMAGE_MIB: "32"
# 0 = no artificial delay.  Set to e.g. 2000 to hold jobs in flight long
# enough to watch them compete.
DISK_EXTEND_DELAY_MS: "0"
# Optional shared secret; when set, every request except /healthz needs
# header X-API-Key.
# DISK_API_KEY: "change-me"
